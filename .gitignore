# NJ Parcel Flood Risk Dashboard — see OPERATING_GUIDE.md §8
# Raw + processed data are never committed (regenerable, statewide-scale, gitignored
# per §8). artifacts/ IS committed but only ever holds small JSON (summaries, meta) —
# big outputs (tiles, parquet) go to Cloudflare R2, never into this repo.
data/raw/
data/processed/

# §7.1 "Artifacts (R2 unless noted)": tiles/parcels/search are the "unless noted"
# exception's opposite -- meant for Cloudflare R2, not this repo (parcels.pmtiles
# alone is >450MB). Only artifacts/summaries/ + ranked_municipalities.json (small,
# aggregate-only JSON, explicitly Pages-hosted) are committed.
artifacts/tiles/
artifacts/parcels/
artifacts/search/

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / web (from Phase 6 onward)
node_modules/
web/dist/
.DS_Store

# Local env
*.local
.env
